
import numpy as np
import random


# 1. Define the Problem: Optimization Function
def optimization_function(solution):
    """Sphere Function for minimization (fitness evaluation)."""
    return sum(x**2 for x in solution)


# 2. Initialize Parameters
POPULATION_SIZE = 50
GENES = 5
MUTATION_RATE = 0.1
CROSSOVER_RATE = 0.7
GENERATIONS = 30

LOWER_BOUND = -10
UPPER_BOUND = 10


# 3. Initialize Population
def initialize_population():

    return [
        np.random.uniform(LOWER_BOUND, UPPER_BOUND, GENES)
        for _ in range(POPULATION_SIZE)
    ]


# 4. Selection
def selection(population):

    # Select two random individuals
    candidates = random.sample(population, 2)

    # Choose the individual with better fitness
    return min(candidates, key=optimization_function)


# 5. Crossover
def crossover(parent1, parent2):

    if random.random() < CROSSOVER_RATE:

        point = random.randint(1, GENES - 1)

        child1 = np.concatenate((
            parent1[:point],
            parent2[point:]
        ))

        child2 = np.concatenate((
            parent2[:point],
            parent1[point:]
        ))

        return child1, child2

    return parent1.copy(), parent2.copy()


# 6. Mutation
def mutation(solution):

    for i in range(GENES):

        if random.random() < MUTATION_RATE:

            solution[i] = np.random.uniform(
                LOWER_BOUND, UPPER_BOUND
            )

    return solution


# 7. Main Genetic Algorithm
def gene_expression_algorithm():

    population = initialize_population()

    for generation in range(GENERATIONS):

        new_population = []

        while len(new_population) < POPULATION_SIZE:

            # Selection
            parent1 = selection(population)
            parent2 = selection(population)

            # Crossover
            child1, child2 = crossover(parent1, parent2)

            # Mutation
            child1 = mutation(child1)
            child2 = mutation(child2)

            new_population.append(child1)
            new_population.append(child2)

        # Update population
        population = new_population[:POPULATION_SIZE]

        # Find best solution
        best_solution = min(
            population,
            key=optimization_function
        )

        best_fitness = optimization_function(best_solution)

        print(
            f"Generation {generation + 1}: "
            f"Best Fitness = {best_fitness:.6f}"
        )

    return best_solution, best_fitness


# 8. Execute Algorithm
best_solution, best_fitness = gene_expression_algorithm()


# 9. Display Results
print("\nOptimization Results:")
print("Best Solution:", best_solution)
print("Best Fitness:", best_fitness)
